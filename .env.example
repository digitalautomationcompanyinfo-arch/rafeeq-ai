# .env.example
# ==============================================================
# مفاتيح واجهات برمجة التطبيقات (API Keys) لنظام "رفيق" (Rafeeq)
# ==============================================================

# (مطلوب) مفتاح Google Gemini - المحرك الرئيسي ومفلتر الحقائق
GEMINI_API_KEY=your_gemini_key_here

# (اختياري) مفتاح DeepSeek للتحليل الخوارزمي والرياضي
DEEPSEEK_API_KEY=your_deepseek_key_here

# (اختياري) مفاتيح AWS Bedrock للوصول إلى Claude 3 وغيرها
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1

# (اختياري) مفتاح OpenAI للوصول إلى GPT-4o
OPENAI_API_KEY=your_openai_key_here

# ==============================================================
# مفاتيح النماذج المجانية ومفتوحة المصدر (Free / Open-Source)
# ==============================================================

# (اختياري) مفتاح Groq للوصول المجاني والسريع لـ Llama 3
GROQ_API_KEY=your_groq_key_here

# (اختياري) مفتاح Hugging Face للوصول للنماذج مفتوحة المصدر (Mistral وغيرها)
HUGGINGFACE_API_KEY=your_huggingface_key_here

# (اختياري) مفتاح OpenRouter للوصول المجاني لنماذج مثل Gemma و Llama 3
OPENROUTER_API_KEY=your_openrouter_key_here

# (اختياري) مفتاح Cohere للوصول لنموذج Command R المفتوح والممتاز للتعليم
COHERE_API_KEY=your_cohere_key_here

